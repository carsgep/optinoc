# ==============================================================================
# POC SBC SIMULADO - Variables de Entorno
# ==============================================================================
# Copiar a .env y completar con tus valores
# ==============================================================================

# ------------------------------------------------------------------------------
# TWILIO - Proveedor de numero telefonico
# ------------------------------------------------------------------------------
# Obtener de: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Numero telefonico comprado en Twilio (formato E.164)
TWILIO_PHONE_NUMBER=+573001234567

# Elastic SIP Trunking - Configurar en Twilio Console
# Ir a: Elastic SIP Trunking > Trunks > [tu trunk] > Termination
TWILIO_SIP_DOMAIN=optinoc-poc.pstn.twilio.com
TWILIO_SIP_USER=optinoc-sip-user
TWILIO_SIP_PASS=tu-password-generado

# ------------------------------------------------------------------------------
# FREEPBX / MARIADB - Base de datos
# ------------------------------------------------------------------------------
DB_PASSWORD=freepbx_secure_password_cambiar
DB_ROOT_PASSWORD=root_secure_password_cambiar

# ------------------------------------------------------------------------------
# DOMINIO Y CERTIFICADOS
# ------------------------------------------------------------------------------
# FQDN publico del SBC (debe resolverse via DNS)
# Opciones:
#   1. Subdominio propio: sbc-poc.tuempresa.com
#   2. Cloudflare Tunnel: sbc-poc.trycloudflare.com
SBC_FQDN=sbc-poc.tudominio.com

# Ruta a certificados SSL (para TLS hacia ACS)
# Puedes usar Let's Encrypt via certbot o Cloudflare Origin Certs
SSL_CERT_PATH=./certs/fullchain.pem
SSL_KEY_PATH=./certs/privkey.pem

# ------------------------------------------------------------------------------
# AZURE COMMUNICATION SERVICES
# ------------------------------------------------------------------------------
# Obtener de: Azure Portal > tu recurso ACS > Keys
ACS_CONNECTION_STRING=endpoint=https://tu-recurso.communication.azure.com/;accesskey=xxxxxxxxxxxxx

# Numero para Caller ID (debe estar registrado en ACS via Direct Routing)
ACS_PHONE_NUMBER=+573001234567

# ------------------------------------------------------------------------------
# CLOUDFLARE TUNNEL (opcional, para exponer sin IP publica)
# ------------------------------------------------------------------------------
# Crear tunnel: cloudflared tunnel create sbc-poc
# Obtener token: cloudflared tunnel token sbc-poc
CLOUDFLARE_TUNNEL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# OPENAI - Para el bot OPTI
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# CALLBACK URI - Para eventos de ACS
# ------------------------------------------------------------------------------
# URL publica donde ACS enviara webhooks
# Opciones:
#   1. Cloudflare Tunnel: https://api-poc.tudominio.com
#   2. Ngrok: https://xxxx.ngrok.io
CALLBACK_URI=https://api-poc.tudominio.com

# ------------------------------------------------------------------------------
# CONFIGURACION DE RED (avanzado)
# ------------------------------------------------------------------------------
# Rango de puertos RTP (reducido para PoC)
RTP_PORT_START=10000
RTP_PORT_END=10100

# NAT - Si estas detras de un router
# Descomentar y poner tu IP publica
# EXTERNAL_IP=XXX.XXX.XXX.XXX
